{
  "$defs": {
    "ArtifactRecord": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Name",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "relative_path",
        "sha256",
        "size_bytes",
        "command",
        "exit_code",
        "required"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "HostInfo": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "minLength": 1,
          "title": "Architecture",
          "type": "string"
        },
        "hostname": {
          "minLength": 1,
          "title": "Hostname",
          "type": "string"
        },
        "kernel_release": {
          "minLength": 1,
          "title": "Kernel Release",
          "type": "string"
        },
        "os_id": {
          "minLength": 1,
          "title": "Os Id",
          "type": "string"
        },
        "os_version_id": {
          "minLength": 1,
          "title": "Os Version Id",
          "type": "string"
        }
      },
      "required": [
        "hostname",
        "kernel_release",
        "os_id",
        "os_version_id",
        "architecture"
      ],
      "title": "HostInfo",
      "type": "object"
    }
  },
  "$id": "https://kylinbootlab.dev/schema/probe-manifest-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRecord"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "boot_id": {
      "format": "uuid",
      "title": "Boot Id",
      "type": "string"
    },
    "boottime_ns": {
      "minimum": 0,
      "title": "Boottime Ns",
      "type": "integer"
    },
    "captured_at_utc": {
      "format": "date-time",
      "title": "Captured At Utc",
      "type": "string"
    },
    "host": {
      "$ref": "#/$defs/HostInfo"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "boot_id",
    "captured_at_utc",
    "boottime_ns",
    "host",
    "artifacts"
  ],
  "title": "ProbeManifest",
  "type": "object"
}
